.ws {
  background: linear-gradient(135deg, #4F46E5 0%, #6366F1 60%, #818CF8 100%);
  border-radius: 28rpx;
  padding: 32rpx;
  margin: 20rpx 24rpx;
  color: #FFFFFF;
  box-shadow: 0 12rpx 32rpx rgba(79, 70, 229, 0.3);
  position: relative;
  overflow: hidden;
}
.ws::after {
  content: '';
  position: absolute;
  right: -60rpx;
  top: -60rpx;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.12);
}
.ws-compact {
  padding: 24rpx 28rpx;
  border-radius: 22rpx;
}

/* 三态配色：open 绿调 / not_open 靛蓝 / closed 灰调 */
.ws.tone-green {
  background: linear-gradient(135deg, #059669 0%, #10B981 60%, #34D399 100%);
  box-shadow: 0 12rpx 32rpx rgba(5, 150, 105, 0.28);
}
.ws.tone-gray {
  background: linear-gradient(135deg, #64748B 0%, #94A3B8 100%);
  box-shadow: 0 12rpx 32rpx rgba(100, 116, 139, 0.25);
}

.ws-head {
  display: flex;
  align-items: center;
  position: relative;
  z-index: 1;
}
.ws-dot-icon {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #FFFFFF;
  margin-right: 16rpx;
  flex-shrink: 0;
  box-shadow: 0 0 0 6rpx rgba(255, 255, 255, 0.25);
}
.ws-status {
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 0.5rpx;
  line-height: 1.4;
}
.ws-countdown {
  margin-top: 16rpx;
  font-size: 40rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
  font-family: 'DIN Alternate', -apple-system, sans-serif;
  position: relative;
  z-index: 1;
}
.ws-semester {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  position: relative;
  z-index: 1;
}
.ws-warn {
  margin-top: 18rpx;
  font-size: 24rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 14rpx;
  padding: 14rpx 20rpx;
  position: relative;
  z-index: 1;
}

.ws-loading,
.ws-error {
  display: flex;
  align-items: center;
  position: relative;
  z-index: 1;
}
.ws-dot {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.35);
  border-top-color: #FFFFFF;
  animation: ws-spin 800ms linear infinite;
  margin-right: 16rpx;
}
@keyframes ws-spin {
  to { transform: rotate(360deg); }
}
.ws-loading-text {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
}
.ws-error {
  justify-content: space-between;
}
.ws-error-text {
  font-size: 26rpx;
  color: #FFFFFF;
  flex: 1;
}
.ws-retry {
  font-size: 26rpx;
  font-weight: 600;
  color: #FFFFFF;
  text-decoration: underline;
  margin-left: 20rpx;
}
