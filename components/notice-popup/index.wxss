.notice-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(30, 27, 75, 0.55);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 48rpx;
}
.notice-modal {
  width: 100%;
  max-height: 78vh;
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 40rpx 36rpx 32rpx;
  box-shadow: 0 24rpx 64rpx rgba(30, 27, 75, 0.3);
  display: flex;
  flex-direction: column;
  animation: notice-in 200ms ease-out;
}
@keyframes notice-in {
  from { opacity: 0; transform: translateY(24rpx) scale(0.97); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}

.notice-head {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}
.notice-badge {
  width: 76rpx;
  height: 76rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #FFF7ED, #FFEDD5);
  text-align: center;
  line-height: 76rpx;
  font-size: 38rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.notice-headtext { flex: 1; min-width: 0; }
.notice-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1E1B4B;
}
.notice-progress {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: #EA580C;
}

.notice-body {
  background: #F8FAFF;
  border-radius: 20rpx;
  padding: 26rpx 24rpx;
}
.notice-item-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1E1B4B;
  line-height: 1.5;
}
.notice-time {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #94A3B8;
}
.notice-content-wrap {
  max-height: 34vh;
  margin-top: 16rpx;
}
.notice-content {
  font-size: 27rpx;
  color: #475569;
  line-height: 1.75;
  white-space: pre-wrap;
  word-break: break-all;
}
.notice-round {
  margin-top: 18rpx;
  background: #FFF7ED;
  color: #EA580C;
  font-size: 23rpx;
  line-height: 1.6;
  padding: 14rpx 18rpx;
  border-radius: 14rpx;
}

.notice-tip {
  margin-top: 18rpx;
  font-size: 23rpx;
  color: #16A34A;
  text-align: center;
}
.notice-err {
  margin-top: 18rpx;
  font-size: 24rpx;
  color: #DC2626;
  text-align: center;
  background: #FEF2F2;
  border-radius: 14rpx;
  padding: 14rpx 18rpx;
}
.notice-btn {
  margin-top: 28rpx;
  width: 100%;
}
.notice-foot {
  margin-top: 16rpx;
  text-align: center;
  font-size: 21rpx;
  color: #94A3B8;
}
