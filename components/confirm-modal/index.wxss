.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(30, 27, 75, 0.45);
  z-index: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 56rpx;
}
.modal {
  width: 100%;
  max-height: 76vh;
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 40rpx 36rpx 32rpx;
  box-shadow: 0 24rpx 64rpx rgba(30, 27, 75, 0.28);
  display: flex;
  flex-direction: column;
  animation: modal-in 180ms ease-out;
}
@keyframes modal-in {
  from { opacity: 0; transform: translateY(24rpx) scale(0.97); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}
.modal-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1E1B4B;
  text-align: center;
  margin-bottom: 24rpx;
}
.modal-body {
  max-height: 48vh;
  flex: 1;
}
.modal-note {
  margin-top: 22rpx;
  padding: 16rpx 20rpx;
  background: #FFF7ED;
  color: #EA580C;
  font-size: 23rpx;
  line-height: 1.6;
  border-radius: 16rpx;
  text-align: center;
}
.modal-actions {
  display: flex;
  margin-top: 28rpx;
}
.modal-btn {
  flex: 1;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  padding: 24rpx 0;
  border-radius: 48rpx;
  transition: opacity 150ms ease;
}
.modal-btn.ghost {
  background: #FFFFFF;
  color: #475569;
  border: 2rpx solid #E0E7FF;
  margin-right: 20rpx;
}
.modal-btn.primary {
  background: linear-gradient(135deg, #4F46E5, #6366F1);
  color: #FFFFFF;
  box-shadow: 0 8rpx 20rpx rgba(79, 70, 229, 0.3);
}
.modal-btn.disabled {
  background: #C7D2FE;
  box-shadow: none;
}
.modal-btn-hover { opacity: 0.82; }
