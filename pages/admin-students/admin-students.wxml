<view class="page">
  <!-- 统计 + 操作 -->
  <view class="toolbar">
    <view class="search-box">
      <input placeholder="搜索学号 / 姓名 / 班级" value="{{keyword}}" bindinput="onSearch" />
    </view>
    <view class="tool-btn add" bindtap="openAdd">＋ 添加</view>
    <view class="tool-btn import" bindtap="openImport">⬆ 导入</view>
  </view>

  <view class="section-title">在册学生（{{students.length}} 人）</view>

  <view class="empty card" wx:if="{{students.length === 0}}">
    <view class="empty-icon">🎓</view>
    <view>暂无学生，点击「导入」批量添加</view>
  </view>

  <view class="card stu-card" wx:for="{{students}}" wx:key="id" wx:for-item="s">
    <view class="stu-main">
      <view class="stu-row1">
        <text class="stu-name">{{s.name}}</text>
        <text class="stu-id">{{s.id}}</text>
      </view>
      <view class="text-weak">{{s.collegeName}} · {{s.className}}</view>
    </view>
    <view class="del" bindtap="onDelete" data-id="{{s.id}}" data-name="{{s.name}}">删除</view>
  </view>

  <!-- 手动添加弹层 -->
  <view class="mask" wx:if="{{showAdd}}" bindtap="closeAdd">
    <view class="sheet" catchtap="noop">
      <view class="h2 sheet-title">添加学生</view>
      <view class="f-row"><text class="f-label">学号</text><input placeholder="必填且唯一" value="{{form.id}}" data-k="id" bindinput="onFormInput" /></view>
      <view class="f-row"><text class="f-label">姓名</text><input placeholder="必填" value="{{form.name}}" data-k="name" bindinput="onFormInput" /></view>
      <view class="f-col">
        <text class="f-label">所属班级（点选）</text>
        <view class="class-row">
          <view
            wx:for="{{allClasses}}"
            wx:key="id"
            wx:for-item="c"
            class="chip {{form.classId === c.id ? 'chip-on' : ''}}"
            bindtap="pickClass"
            data-id="{{c.id}}"
          >{{c.label}}</view>
        </view>
      </view>
      <button class="btn-primary sheet-btn" hover-class="button-hover" bindtap="saveAdd">保存</button>
    </view>
  </view>

  <!-- 批量导入弹层 -->
  <view class="mask" wx:if="{{showImport}}" bindtap="closeImport">
    <view class="sheet" catchtap="noop">
      <view class="h2 sheet-title">批量导入学生</view>

      <block wx:if="{{!pasteMode}}">
        <view class="text-weak import-tip">
          推荐：在电脑 Excel 中按模板整理好名单（学号、姓名、学院、专业、班级全称五列），把文件通过微信「文件传输助手」发给自己，再点击下方按钮从会话中选取。
        </view>
        <button class="btn-primary sheet-btn" hover-class="button-hover" bindtap="chooseExcel" loading="{{parsing}}">选择 Excel 文件导入</button>
        <button class="btn-ghost sheet-btn-tight" hover-class="button-hover" bindtap="downloadTemplate">下载导入模板（xlsx）</button>
        <view class="paste-switch" bindtap="togglePaste">没有文件？改用粘贴导入 ›</view>
      </block>

      <block wx:else>
        <view class="text-weak import-tip">
          每行一个学生，字段用 Tab 或 | 分隔：学号 | 姓名 | 学院名称 | 专业名称 | 班级全称（如 2024级1班）
        </view>
        <textarea
          class="import-area"
          placeholder="20240901|王小明|计算机科学与工程学院|计算机科学与技术|2024级1班"
          value="{{importText}}"
          bindinput="onImportInput"
          maxlength="-1"
        ></textarea>
        <view class="sheet-btn-row">
          <button class="btn-ghost half-btn" bindtap="fillDemo">填入示例</button>
          <button class="btn-primary half-btn" bindtap="doImport">解析并导入</button>
        </view>
        <view class="paste-switch" bindtap="togglePaste">‹ 返回文件导入</view>
      </block>

      <view class="import-result" wx:if="{{importResult}}">
        <text class="ok">成功导入 {{importResult.added.length}} 人</text>
        <text class="bad" wx:if="{{importResult.skipped.length}}">；{{importResult.skipped.length}} 条未通过校验</text>
        <view class="error-list" wx:if="{{importResult.skipped.length}}">
          <view class="error-item" wx:for="{{importResult.skipped}}" wx:key="index" wx:for-item="msg">{{msg}}</view>
        </view>
      </view>
    </view>
  </view>
</view>
