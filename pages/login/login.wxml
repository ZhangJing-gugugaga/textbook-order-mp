<view class="login-page">
  <view class="deco deco-1"></view>
  <view class="deco deco-2"></view>
  <view class="deco deco-3"></view>

  <view class="hero">
    <view class="logo-ring">
      <text class="logo-icon">📚</text>
    </view>
    <view class="app-name">教材征订系统</view>
    <view class="app-slogan">统一征订 · 在线勾选 · 数据统计</view>
  </view>

  <view class="form-card card">
    <view class="input-row">
      <view class="input-label">学号/工号</view>
      <input placeholder="请输入学号或教师工号" placeholder-class="ph" value="{{id}}" bindinput="onIdInput" />
    </view>
    <view class="input-row">
      <view class="input-label">姓名</view>
      <input placeholder="请输入真实姓名" placeholder-class="ph" value="{{name}}" bindinput="onNameInput" />
    </view>
    <button class="btn-primary login-btn" hover-class="button-hover" bindtap="onLogin" loading="{{loading}}">登 录</button>
    <view class="error-tip" wx:if="{{error}}">{{error}}</view>
  </view>

  <view class="demo card">
    <view class="demo-title">演示账号 · 点击自动填入</view>
    <view class="demo-row" hover-class="demo-row-hover" bindtap="fillStudent">
      <view class="icon-badge icon-indigo demo-badge">🎓</view>
      <view class="demo-info">
        <view class="demo-role">学生</view>
        <view class="demo-acc">20240101 · 张敬</view>
      </view>
      <view class="cell-arrow">›</view>
    </view>
    <view class="demo-row" hover-class="demo-row-hover" bindtap="fillAdmin">
      <view class="icon-badge icon-green demo-badge">🛠️</view>
      <view class="demo-info">
        <view class="demo-role">教材管理员</view>
        <view class="demo-acc">T0001 · 王教材</view>
      </view>
      <view class="cell-arrow">›</view>
    </view>
    <view class="demo-tip">学校学号与姓名匹配后方可进入</view>
  </view>
</view>
