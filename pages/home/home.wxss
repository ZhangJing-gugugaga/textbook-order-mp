.page { padding-bottom: 60rpx; }

/* ===== 问候 hero ===== */
.greeting { margin-top: 32rpx; }
.greet-title {
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  position: relative;
  z-index: 1;
}
.greet-sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  opacity: 0.85;
  position: relative;
  z-index: 1;
}

/* ===== 入口卡 ===== */
.entry-card {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  transition: transform 150ms ease;
}
.card-hover { transform: translateY(-2rpx); }
.entry-main { flex: 1; min-width: 0; }
.entry-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1E1B4B;
}
.entry-sub {
  font-size: 24rpx;
  color: #475569;
  margin-top: 8rpx;
}

/* ===== 状态卡 ===== */
.form-card { margin-top: 16rpx; }
.form-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}
.form-head .tag { flex-shrink: 0; }
.form-label {
  font-size: 30rpx;
  font-weight: 600;
  color: #1E1B4B;
  flex: 1;
  min-width: 0;
}
.form-hint {
  font-size: 25rpx;
  color: #475569;
  line-height: 1.6;
}
.form-time {
  margin-top: 14rpx;
  font-size: 23rpx;
  color: #94A3B8;
}
.form-deadline {
  margin-top: 14rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #EA580C;
  background: #FFF7ED;
  border-radius: 14rpx;
  padding: 14rpx 20rpx;
}
.form-btn { margin-top: 26rpx; }
.form-tip {
  margin-top: 18rpx;
  font-size: 23rpx;
  color: #94A3B8;
  text-align: center;
}

/* ===== 学生统计行 ===== */
.stat-row {
  display: flex;
  margin: 24rpx 0 4rpx;
}
.stat-item { flex: 1; text-align: center; }
.stat-num {
  font-size: 40rpx;
  font-weight: 800;
  color: #4F46E5;
  font-family: 'DIN Alternate', -apple-system, sans-serif;
  line-height: 1.2;
}
.stat-label {
  font-size: 22rpx;
  color: #94A3B8;
  margin-top: 8rpx;
}

/* ===== Web 端引导 ===== */
.web-card {
  margin-top: 40rpx;
  text-align: center;
  padding: 56rpx 40rpx;
}
.web-badge {
  width: 120rpx;
  height: 120rpx;
  border-radius: 32rpx;
  font-size: 56rpx;
  margin: 0 auto 28rpx;
}
.web-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1E1B4B;
}
.web-desc {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: #475569;
  line-height: 1.8;
  text-align: left;
}
.web-desc .strong { font-weight: 700; color: #4F46E5; }
.web-account {
  margin-top: 24rpx;
  font-size: 24rpx;
  color: #94A3B8;
}
.web-btn { margin-top: 24rpx; }
