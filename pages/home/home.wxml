<view class="page">
  <!-- ===== 窗口状态卡（三态 + 倒计时，60s 轮询） ===== -->
  <window-status wx:if="{{mode !== 'web'}}" bind:change="onWindowChange" />

  <!-- ===== 教师首页 ===== -->
  <block wx:if="{{mode === 'teacher'}}">
    <view class="card-hero greeting">
      <view class="greet-title">{{me.name}}，你好</view>
      <view class="greet-sub">{{roleText}} · {{me.collegeName || '未分配学院'}}</view>
    </view>

    <view class="section-title">我的课程</view>
    <view class="card entry-card" hover-class="card-hover" bindtap="goTeacherCourses">
      <view class="entry-main">
        <view class="entry-title">任课关系</view>
        <view class="entry-sub">{{courseSummary}}</view>
      </view>
      <view class="cell-arrow">›</view>
    </view>

    <view class="section-title">本学期填报</view>
    <view class="card form-card" wx:if="{{formStatus}}">
      <view class="form-head">
        <view class="form-label">填报状态</view>
        <view class="tag {{formStatus.tone}}">{{formStatus.label}}</view>
      </view>
      <view class="form-hint">{{formStatus.hint}}</view>
      <view class="form-time" wx:if="{{formStatus.timeText}}">{{formStatus.timeText}}</view>
      <view class="form-deadline" wx:if="{{correctDeadlineText}}">{{correctDeadlineText}}</view>
      <button class="btn-primary form-btn" hover-class="button-hover" bindtap="goTeacherForm">
        {{needCorrection ? '去补正重提' : (formStatus.label === '未提交' ? '去填报' : '查看/修改填报')}}
      </button>
    </view>

    <view class="card entry-card" hover-class="card-hover" bindtap="goTeacherRecords">
      <view class="entry-main">
        <view class="entry-title">我的提交记录</view>
        <view class="entry-sub">历史学期填报与审查状态</view>
      </view>
      <view class="cell-arrow">›</view>
    </view>
  </block>

  <!-- ===== 学生首页 ===== -->
  <block wx:elif="{{mode === 'student'}}">
    <view class="card-hero greeting">
      <view class="greet-title">{{me.name}}，你好</view>
      <view class="greet-sub">
        {{roleText}} · {{me.className || '未分配班级'}}
      </view>
    </view>

    <view class="section-title">教材征订</view>
    <view class="card form-card">
      <view class="form-head">
        <view class="form-label">我的选购单</view>
        <view class="tag {{hasOrder ? 'tag-success' : 'tag-optional'}}">{{orderStatusText}}</view>
      </view>

      <block wx:if="{{hasOrder}}">
        <view class="stat-row">
          <view class="stat-item">
            <view class="stat-num">{{orderItemCount}}</view>
            <view class="stat-label">教材品种</view>
          </view>
          <view class="stat-item">
            <view class="stat-num">{{orderTotalQuantity}}</view>
            <view class="stat-label">总数量</view>
          </view>
          <view class="stat-item">
            <view class="stat-num">{{orderTotalPrice}}</view>
            <view class="stat-label">金额合计（元）</view>
          </view>
        </view>
        <view class="form-time" wx:if="{{orderSubmittedAt}}">提交于 {{orderSubmittedAt}}</view>
      </block>
      <view class="form-hint" wx:else>尚未提交选购单，请在征订窗口内完成勾选。</view>

      <button class="btn-primary form-btn" hover-class="button-hover" bindtap="goOrder">
        {{hasOrder ? '修改我的选购' : '去勾选教材'}}
      </button>
      <view class="form-tip" wx:if="{{!windowCanSubmit && windowStatus === 'closed'}}">
        本期征订已截止，选购页仅供查看历史记录
      </view>
    </view>

    <view class="card entry-card" hover-class="card-hover" bindtap="goProfile">
      <view class="entry-main">
        <view class="entry-title">我的征订记录</view>
        <view class="entry-sub">历史学期选购明细与金额合计</view>
      </view>
      <view class="cell-arrow">›</view>
    </view>
  </block>

  <!-- ===== 非师生身份：引导至 Web 端 ===== -->
  <block wx:elif="{{mode === 'web'}}">
    <view class="card web-card">
      <view class="icon-badge icon-orange web-badge">🖥️</view>
      <view class="web-title">该身份请使用 Web 端</view>
      <view class="web-desc">
        小程序端仅面向<text class="strong">任课老师</text>与<text class="strong">学生</text>。
        当前身份「{{roleText}}」的功能（教材库、账号、统计、审核、导出等）请在电脑端 Web 系统操作。
      </view>
      <view class="web-account" wx:if="{{me}}">{{me.name}} · {{me.userNo}}</view>
      <button class="btn-ghost web-btn" hover-class="button-hover" bindtap="goProfile">前往「我的」切换身份</button>
      <button class="btn-primary web-btn" hover-class="button-hover" bindtap="onLogout">退出登录</button>
    </view>
  </block>
</view>
