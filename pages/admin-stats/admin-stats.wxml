<view class="page">
  <!-- 任务选择 -->
  <view class="card picker-card">
    <view class="field-label">选择征订任务</view>
    <picker range="{{orderNames}}" value="{{orderIndex}}" bindchange="onOrderChange">
      <view class="picker-value">
        {{orderNames[orderIndex] || '暂无任务'}}
        <text class="picker-arrow">▾</text>
      </view>
    </picker>
  </view>

  <block wx:if="{{stats}}">
    <!-- 总览 -->
    <view class="card total-card">
      <view class="total-item">
        <view class="total-num">{{stats.total}}</view>
        <view class="text-weak">应订人数</view>
      </view>
      <view class="total-item">
        <view class="total-num done">{{stats.submitted}}</view>
        <view class="text-weak">已提交</view>
      </view>
      <view class="total-item">
        <view class="total-num">{{overallRate}}%</view>
        <view class="text-weak">总体比例</view>
      </view>
    </view>

    <!-- 学院比例（饼图 + 条形） -->
    <view class="section-title">学院订书比例</view>
    <view class="card chart-card">
      <view class="chart-wrap">
        <canvas type="2d" id="pieCanvas" class="pie-canvas"></canvas>
        <view class="legend">
          <view class="legend-item" wx:for="{{stats.byCollege}}" wx:key="id">
            <view class="dot" style="background: {{colors[index]}}"></view>
            <view class="legend-name">{{item.name}}</view>
            <view class="legend-val">{{item.rate}}%</view>
          </view>
        </view>
      </view>
      <view class="bar-list">
        <view class="bar-row" wx:for="{{stats.byCollege}}" wx:key="id">
          <view class="bar-name">{{item.name}}</view>
          <view class="bar-track"><view class="bar-fill" style="width: {{item.rate}}%"></view></view>
          <view class="bar-val">{{item.submitted}}/{{item.total}}</view>
        </view>
      </view>
    </view>

    <!-- 专业比例 -->
    <view class="section-title">专业订书比例</view>
    <view class="card">
      <view class="bar-row" wx:for="{{stats.byMajor}}" wx:key="id">
        <view class="bar-name">{{item.name}}</view>
        <view class="bar-track"><view class="bar-fill" style="width: {{item.rate}}%"></view></view>
        <view class="bar-val">{{item.submitted}}/{{item.total}}</view>
      </view>
    </view>

    <!-- 班级比例 -->
    <view class="section-title">班级订书比例</view>
    <view class="card">
      <view class="bar-row" wx:for="{{stats.byClass}}" wx:key="id">
        <view class="bar-name">{{item.name}}</view>
        <view class="bar-track"><view class="bar-fill" style="width: {{item.rate}}%"></view></view>
        <view class="bar-val">{{item.submitted}}/{{item.total}}</view>
      </view>
    </view>

    <!-- 教材汇总 -->
    <view class="section-title">教材征订数据</view>
    <view class="card">
      <view class="book-row book-head">
        <view class="col-title">书名</view>
        <view class="col-num">数量</view>
        <view class="col-amount">金额</view>
      </view>
      <view class="book-row" wx:for="{{stats.byBook}}" wx:key="id">
        <view class="col-title">{{item.title}}</view>
        <view class="col-num">{{item.count}}</view>
        <view class="col-amount">¥{{item.amount}}</view>
      </view>
    </view>

    <!-- 漏订催办 -->
    <view class="section-title">漏订催办（{{missing.length}} 人）</view>
    <view class="card">
      <view class="empty" wx:if="{{missing.length === 0}}">
        <view>全部提交完毕 🎉</view>
      </view>
      <view class="miss-row" wx:for="{{missing}}" wx:key="id">
        <view class="miss-info">
          <text class="miss-name">{{item.name}}</text>
          <text class="text-weak">{{item.className}}</text>
        </view>
        <view class="btn-ghost miss-btn" bindtap="remindOne" data-name="{{item.name}}">催办</view>
      </view>
    </view>

    <!-- 导出 -->
    <view class="export-wrap">
      <button class="btn-primary" bindtap="onExportExcel">导出 Excel 表格（.xlsx）</button>
      <view class="text-weak export-tip">生成后可直接转发到微信，电脑/手机 Excel 均可打开</view>
      <button class="btn-ghost export-ghost" bindtap="onExport">复制 CSV 到剪贴板（电脑粘贴用）</button>
    </view>
  </block>

  <view class="empty card" wx:else>
    <view class="empty-icon">📊</view>
    <view>暂无征订任务</view>
  </view>
</view>
