.page { padding-bottom: 60rpx; }

.toolbar {
  display: flex;
  align-items: center;
  padding: 24rpx 24rpx 0;
  gap: 16rpx;
}
.search-box {
  flex: 1;
  background: #FFF;
  border-radius: 999rpx;
  padding: 16rpx 28rpx;
}
.search-box input { font-size: 26rpx; }
.tool-btn {
  padding: 16rpx 24rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #FFF;
  font-weight: 500;
}
.tool-btn.add { background: #4F46E5; }
.tool-btn.import { background: #16A34A; }

/* 教材卡 */
.book-card { margin-top: 16rpx; }
.book-row { display: flex; }
.book-main { flex: 1; }
.book-title-row { display: flex; align-items: center; margin-bottom: 8rpx; }
.book-title { font-size: 30rpx; font-weight: 500; margin-right: 12rpx; }
.line { margin-top: 4rpx; }
.book-side { text-align: right; margin-left: 16rpx; }
.price { color: #EA580C; font-weight: 600; font-size: 30rpx; }
.del {
  margin-top: 16rpx;
  color: #DC2626;
  font-size: 24rpx;
  padding: 6rpx 20rpx;
  background: #FFF1F0;
  border-radius: 999rpx;
  display: inline-block;
}

/* 弹层 */
.mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 10;
  display: flex;
  align-items: flex-end;
}
.sheet {
  width: 100%;
  max-height: 85vh;
  overflow-y: auto;
  background: #FFF;
  border-radius: 32rpx 32rpx 0 0;
  padding: 36rpx 32rpx calc(36rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.sheet-title { margin-bottom: 16rpx; }
.f-row {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #F1F5F9;
}
.f-label { width: 170rpx; color: #475569; font-size: 26rpx; flex-shrink: 0; }
.f-row input { flex: 1; font-size: 28rpx; }
.f-col { padding: 18rpx 0; }
.class-row { display: flex; flex-wrap: wrap; gap: 14rpx; margin-top: 12rpx; }
.chip {
  padding: 10rpx 22rpx;
  background: #EEF2FF;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #475569;
  border: 2rpx solid transparent;
}
.chip-on { background: #EEF2FF; color: #4F46E5; border-color: #4F46E5; }
.sheet-btn { margin-top: 28rpx; }
.sheet-btn-tight { margin-top: 20rpx; }
.paste-switch {
  margin-top: 24rpx;
  text-align: center;
  color: #4F46E5;
  font-size: 24rpx;
  padding: 8rpx 0;
}
.sheet-btn-row { display: flex; gap: 20rpx; margin-top: 24rpx; }
.half-btn { flex: 1; }

.import-tip { line-height: 1.7; margin-bottom: 16rpx; }
.import-area {
  width: 100%;
  height: 240rpx;
  background: #EEF2FF;
  border-radius: 16rpx;
  padding: 20rpx;
  font-size: 24rpx;
  box-sizing: border-box;
}
.import-classes { margin-top: 16rpx; line-height: 1.7; }
