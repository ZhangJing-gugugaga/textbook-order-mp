<view class="page">
  <!-- 搜索 + 操作 -->
  <view class="toolbar">
    <view class="search-box">
      <input placeholder="搜索书名 / 课程 / 教师" value="{{keyword}}" bindinput="onSearch" />
    </view>
    <view class="tool-btn add" bindtap="openAdd">＋ 添加</view>
    <view class="tool-btn import" bindtap="openImport">⬆ 导入</view>
  </view>

  <!-- 教材列表 -->
  <view class="section-title">教材库（{{books.length}} 种）</view>
  <view class="empty card" wx:if="{{books.length === 0}}">
    <view class="empty-icon">📚</view>
    <view>暂无教材，点击右上角「导入」批量添加</view>
  </view>

  <view class="card book-card" wx:for="{{books}}" wx:key="id" wx:for-item="b">
    <view class="book-row">
      <view class="book-main">
        <view class="book-title-row">
          <view class="book-title">{{b.title}}</view>
          <view class="tag {{b.required ? 'tag-required' : 'tag-optional'}}">{{b.required ? '必修' : '选修'}}</view>
        </view>
        <view class="text-weak line">{{b.edition}} · {{b.author}} · {{b.press}}</view>
        <view class="text-weak line">课程：{{b.course}} · 选用教师：{{b.teacher}}</view>
        <view class="text-weak line">适用班级：{{b.classNames}}</view>
      </view>
      <view class="book-side">
        <view class="price">¥{{b.price}}</view>
        <view class="del" bindtap="onDelete" data-id="{{b.id}}" data-title="{{b.title}}">删除</view>
      </view>
    </view>
  </view>

  <!-- 手动添加弹层 -->
  <view class="mask" wx:if="{{showAdd}}" bindtap="closeAdd">
    <view class="sheet" catchtap="">
      <view class="h2 sheet-title">添加教材</view>
      <view class="f-row"><text class="f-label">书名</text><input placeholder="必填" value="{{form.title}}" data-k="title" bindinput="onFormInput" /></view>
      <view class="f-row"><text class="f-label">版次</text><input placeholder="如：第七版" value="{{form.edition}}" data-k="edition" bindinput="onFormInput" /></view>
      <view class="f-row"><text class="f-label">作者</text><input value="{{form.author}}" data-k="author" bindinput="onFormInput" /></view>
      <view class="f-row"><text class="f-label">出版社</text><input value="{{form.press}}" data-k="press" bindinput="onFormInput" /></view>
      <view class="f-row"><text class="f-label">单价</text><input type="digit" placeholder="0.00" value="{{form.price}}" data-k="price" bindinput="onFormInput" /></view>
      <view class="f-row"><text class="f-label">课程名</text><input value="{{form.course}}" data-k="course" bindinput="onFormInput" /></view>
      <view class="f-row"><text class="f-label">选用教师</text><input value="{{form.teacher}}" data-k="teacher" bindinput="onFormInput" /></view>
      <view class="f-row">
        <text class="f-label">必修</text>
        <switch checked="{{form.required}}" bindchange="onFormSwitch" color="#4F46E5" />
      </view>
      <view class="f-col">
        <text class="f-label">适用班级（点选）</text>
        <view class="class-row">
          <view
            wx:for="{{allClasses}}"
            wx:key="id"
            wx:for-item="c"
            class="chip {{form.classIds.indexOf(c.id) >= 0 ? 'chip-on' : ''}}"
            bindtap="toggleFormClass"
            data-id="{{c.id}}"
          >{{c.label}}</view>
        </view>
      </view>
      <button class="btn-primary sheet-btn" bindtap="saveAdd">保存</button>
    </view>
  </view>

  <!-- 批量导入弹层 -->
  <view class="mask" wx:if="{{showImport}}" bindtap="closeImport">
    <view class="sheet" catchtap="">
      <view class="h2 sheet-title">批量导入（Excel 粘贴）</view>
      <view class="text-weak import-tip">
        在 Excel 中选中数据列复制后粘贴到下方。每行一本教材，字段用 Tab 或 | 分隔：
        书名 | 版次 | 作者 | 出版社 | 单价 | 课程名 | 选用教师 | 适用班级ID(逗号分隔) | 必修(是/否)
      </view>
      <textarea
        class="import-area"
        placeholder="高等数学（上册）|第七版|同济大学数学系|高等教育出版社|45|高等数学|张伟|CST2401,CST2402|是"
        value="{{importText}}"
        bindinput="onImportInput"
        maxlength="-1"
      ></textarea>
      <view class="sheet-btn-row">
        <button class="btn-ghost half-btn" bindtap="fillDemo">填入示例</button>
        <button class="btn-primary half-btn" bindtap="doImport">解析并导入</button>
      </view>
      <view class="text-weak import-classes">可用班级ID：CST2401 计算机2401班 · CST2402 计算机2402班 · SE2401 软工2401班 · EN2401 英语2401班 · BM2401 工商2401班</view>
    </view>
  </view>
</view>
