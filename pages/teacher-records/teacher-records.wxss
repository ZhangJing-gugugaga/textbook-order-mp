.page { padding-bottom: 60rpx; }

.state-card { margin-top: 24rpx; }
.state-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx 0;
}
.spin {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  border: 4rpx solid #E0E7FF;
  border-top-color: #4F46E5;
  animation: spin 800ms linear infinite;
  margin-right: 16rpx;
}
@keyframes spin { to { transform: rotate(360deg); } }
.empty-sub { margin-top: 12rpx; }
.retry {
  margin-top: 20rpx;
  color: #4F46E5;
  font-weight: 600;
  font-size: 26rpx;
}
.go-form { margin: 32rpx 24rpx 0; }

/* ===== 记录卡 ===== */
.rec-card { margin-top: 20rpx; }
.rec-head {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}
.rec-head .tag { flex-shrink: 0; }
.rec-title {
  flex: 1;
  min-width: 0;
  font-size: 31rpx;
  font-weight: 700;
  color: #1E1B4B;
  line-height: 1.4;
  word-break: break-all;
}
.rec-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin: 16rpx 0 6rpx;
}
.meta-item {
  background: #F8FAFF;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: #475569;
}
.rec-note {
  margin-top: 14rpx;
  background: #FEF2F2;
  color: #DC2626;
  font-size: 24rpx;
  line-height: 1.6;
  padding: 16rpx 20rpx;
  border-radius: 14rpx;
}

/* ===== 状态轨迹 ===== */
.track {
  margin-top: 22rpx;
  padding-left: 8rpx;
}
.track-step {
  display: flex;
  align-items: flex-start;
  position: relative;
  padding-bottom: 22rpx;
}
.track-step:last-child { padding-bottom: 0; }
/* 连接线 */
.track-step:not(:last-child)::before {
  content: '';
  position: absolute;
  left: 9rpx;
  top: 24rpx;
  bottom: 0;
  width: 2rpx;
  background: #E0E7FF;
}
.track-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  flex-shrink: 0;
  margin-top: 6rpx;
  margin-right: 20rpx;
  background: #C7D2FE;
  position: relative;
  z-index: 1;
}
.track-dot.done { background: #16A34A; }
.track-dot.pending { background: #F59E0B; }
.track-dot.fail { background: #DC2626; }
.track-main { flex: 1; min-width: 0; }
.track-name {
  font-size: 27rpx;
  color: #1E1B4B;
  font-weight: 500;
}
.track-note { font-size: 24rpx; color: #94A3B8; font-weight: 400; }
.track-note.fail { color: #DC2626; }
.track-note.done { color: #16A34A; }
.track-time {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #94A3B8;
}

/* ===== 明细 ===== */
.detail-box {
  margin-top: 20rpx;
  background: #F8FAFF;
  border-radius: 18rpx;
  padding: 22rpx 24rpx;
}
.detail-title {
  font-size: 25rpx;
  font-weight: 600;
  color: #475569;
  margin-bottom: 12rpx;
}
.detail-loading {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
}
.detail-loading .spin { width: 26rpx; height: 26rpx; }
.detail-row {
  display: flex;
  align-items: flex-start;
  padding: 16rpx 0;
  border-bottom: 1rpx dashed #E0E7FF;
}
.detail-row:last-child { border-bottom: none; }
.detail-main { flex: 1; min-width: 0; }
.detail-book {
  font-size: 27rpx;
  color: #1E1B4B;
  font-weight: 500;
  word-break: break-all;
}
.detail-sub { margin-top: 4rpx; }
.detail-qty {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #4F46E5;
}
.detail-empty {
  text-align: center;
  padding: 12rpx 0;
  line-height: 1.6;
}

.no-export {
  text-align: center;
  font-size: 22rpx;
  color: #94A3B8;
  margin-top: 32rpx;
}
