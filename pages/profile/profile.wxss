.page { padding-bottom: 60rpx; }

/* ===== 用户卡：渐变 hero ===== */
.user-card {
  display: flex;
  align-items: center;
  margin: 24rpx;
  padding: 44rpx 36rpx;
  border-radius: 28rpx;
  color: #FFFFFF;
  background: linear-gradient(135deg, #4F46E5 0%, #6366F1 60%, #818CF8 100%);
  box-shadow: 0 12rpx 32rpx rgba(79, 70, 229, 0.35);
  position: relative;
  overflow: hidden;
}
.user-card::after {
  content: '';
  position: absolute;
  right: -60rpx;
  top: -60rpx;
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.12);
}
.avatar {
  width: 104rpx;
  height: 104rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.22);
  border: 2rpx solid rgba(255, 255, 255, 0.35);
  font-size: 44rpx;
  font-weight: 700;
  text-align: center;
  line-height: 100rpx;
  margin-right: 26rpx;
  position: relative;
  z-index: 1;
  flex-shrink: 0;
}
.user-info { position: relative; z-index: 1; flex: 1; min-width: 0; }
.user-name { font-size: 38rpx; font-weight: 700; letter-spacing: 1rpx; }
.user-sub { font-size: 24rpx; opacity: 0.8; margin-top: 8rpx; }
.user-card .tag {
  margin-left: auto;
  flex-shrink: 0;
  white-space: nowrap;
  max-width: 240rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  background: rgba(255, 255, 255, 0.2);
  border: 1rpx solid rgba(255, 255, 255, 0.35);
  color: #FFFFFF;
  position: relative;
  z-index: 1;
}

/* ===== 微信绑定 ===== */
.bind-card { padding: 28rpx 32rpx; }
.bind-row { display: flex; align-items: center; }
.bind-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  text-align: center;
  line-height: 72rpx;
  font-size: 34rpx;
  margin-right: 22rpx;
  flex-shrink: 0;
}
.bind-icon.on { background: linear-gradient(135deg, #ECFDF5, #D1FAE5); }
.bind-icon.off { background: linear-gradient(135deg, #FFF7ED, #FFEDD5); }
.bind-main { flex: 1; min-width: 0; }
.bind-title { font-size: 29rpx; font-weight: 600; color: #1E1B4B; }
.bind-sub { font-size: 23rpx; color: #475569; margin-top: 6rpx; }
.bind-btn {
  width: 190rpx;
  flex-shrink: 0;
  margin: 0 0 0 18rpx;
  padding: 16rpx 0;
  font-size: 26rpx;
}
.bind-note {
  margin-top: 20rpx;
  font-size: 22rpx;
  color: #94A3B8;
  line-height: 1.6;
}

/* ===== 通知区 ===== */
.notice-card { padding: 0 32rpx 8rpx; }
.notice-tabs {
  display: flex;
  border-bottom: 1rpx solid #F1F5F9;
}
.notice-tab {
  flex: 1;
  text-align: center;
  padding: 26rpx 0;
  font-size: 27rpx;
  color: #94A3B8;
  position: relative;
}
.notice-tab.active {
  color: #4F46E5;
  font-weight: 700;
}
.notice-tab.active::after {
  content: '';
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  bottom: 0;
  width: 56rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: linear-gradient(90deg, #4F46E5, #818CF8);
}
.notice-row {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F1F5F9;
}
.notice-row:last-child { border-bottom: none; }
.notice-row-head {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}
.notice-row-head .tag { flex-shrink: 0; }
.notice-row-title {
  flex: 1;
  min-width: 0;
  font-size: 29rpx;
  font-weight: 600;
  color: #1E1B4B;
  line-height: 1.5;
  word-break: break-all;
}
.notice-row-content {
  margin-top: 10rpx;
  font-size: 25rpx;
  color: #475569;
  line-height: 1.7;
  word-break: break-all;
}
.notice-row-time {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #94A3B8;
}
.notice-row-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 6rpx;
}
.notice-row-foot .notice-row-time { margin-top: 0; }
.notice-confirm {
  font-size: 25rpx;
  font-weight: 600;
  color: #4F46E5;
  border: 2rpx solid #C7D2FE;
  border-radius: 999rpx;
  padding: 8rpx 28rpx;
}
.notice-confirm:active { background: #EEF2FF; }

/* ===== 切换身份 ===== */
.role-card { padding: 8rpx 32rpx 24rpx; }
.role-item {
  display: flex;
  align-items: center;
  padding: 26rpx 0;
  border-bottom: 1rpx solid #F1F5F9;
}
.role-item:last-of-type { border-bottom: none; }
.role-hover { opacity: 0.7; }
.role-label { flex: 1; font-size: 29rpx; color: #1E1B4B; font-weight: 500; }
.role-state { font-size: 24rpx; color: #94A3B8; }
.role-item.current .role-label { color: #4F46E5; font-weight: 700; }
.role-item.current .role-state { color: #16A34A; font-weight: 600; }
.role-note {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #94A3B8;
  line-height: 1.6;
}

/* ===== 菜单 ===== */
.menu-card { padding: 0 32rpx; overflow: hidden; }
.cell-hover { background: #F8FAFF; }
.menu-icon {
  display: inline-flex;
  width: 48rpx;
  margin-right: 20rpx;
  justify-content: center;
}

/* ===== 退出登录 ===== */
.logout-card {
  text-align: center;
  margin-top: 24rpx;
  padding: 30rpx 0;
}
.logout-hover { background: #FEF2F2; }
.logout { color: #DC2626; font-size: 30rpx; font-weight: 600; }

/* ===== 版本 ===== */
.version {
  text-align: center;
  font-size: 22rpx;
  color: #94A3B8;
  margin-top: 32rpx;
}
.version.env {
  margin-top: 8rpx;
  color: #CBD5E1;
  font-size: 20rpx;
}

/* ===== 改密弹层 ===== */
.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(30, 27, 75, 0.45);
  z-index: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 56rpx;
}
.modal {
  width: 100%;
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 40rpx 36rpx 32rpx;
  box-shadow: 0 24rpx 64rpx rgba(30, 27, 75, 0.28);
}
.modal-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1E1B4B;
  text-align: center;
  margin-bottom: 28rpx;
}
.ph { color: #94A3B8; }
.error-tip {
  color: #DC2626;
  font-size: 24rpx;
  text-align: center;
  margin-top: 8rpx;
}
.modal-actions { display: flex; margin-top: 28rpx; }
.modal-btn {
  flex: 1;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  padding: 24rpx 0;
  border-radius: 48rpx;
  transition: opacity 150ms ease;
}
.modal-btn.ghost {
  background: #FFFFFF;
  color: #475569;
  border: 2rpx solid #E0E7FF;
  margin-right: 20rpx;
}
.modal-btn.primary {
  background: linear-gradient(135deg, #4F46E5, #6366F1);
  color: #FFFFFF;
  box-shadow: 0 8rpx 20rpx rgba(79, 70, 229, 0.3);
}
.modal-btn-hover { opacity: 0.82; }

/* ===== 选购记录（学生身份） ===== */
.rec-card { padding: 4rpx 24rpx 20rpx; }
.rec-row {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F1F5F9;
}
.rec-row:last-child { border-bottom: none; }
.rec-head {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}
.rec-head .tag { flex-shrink: 0; }
.rec-title {
  flex: 1;
  min-width: 0;
  font-size: 29rpx;
  font-weight: 600;
  color: #1E1B4B;
}
.rec-meta {
  display: flex;
  gap: 20rpx;
  margin-top: 10rpx;
}
.rec-meta-item {
  font-size: 25rpx;
  color: #475569;
}
.rec-sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #94A3B8;
}
.rec-note {
  padding-top: 16rpx;
  font-size: 23rpx;
  line-height: 1.6;
  color: #94A3B8;
}
