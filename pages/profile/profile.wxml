<view class="page">
  <!-- ===== 身份卡 ===== -->
  <view class="user-card">
    <view class="avatar">{{me.name ? me.name[0] : '·'}}</view>
    <view class="user-info">
      <view class="user-name">{{me.name || '未登录'}}</view>
      <view class="user-sub">{{me.userNo || '—'}}</view>
      <view class="user-sub">{{collegeText}}</view>
    </view>
    <view class="tag">{{roleText}}</view>
  </view>

  <!-- ===== 微信绑定与订阅授权 ===== -->
  <view class="section-title">微信通知</view>
  <view class="card bind-card">
    <view class="bind-row">
      <view class="bind-icon {{openidBound ? 'on' : 'off'}}">{{openidBound ? '✅' : '⚠️'}}</view>
      <view class="bind-main">
        <view class="bind-title">{{openidBound ? '已绑定微信' : '未绑定微信'}}</view>
        <view class="bind-sub">{{subscribeText}}</view>
      </view>
      <button
        wx:if="{{!openidBound}}"
        class="btn-ghost bind-btn"
        hover-class="button-hover"
        bindtap="onBindWx"
        loading="{{binding}}"
      >
        绑定微信
      </button>
    </view>
    <view class="bind-note">订阅消息仅对已绑定微信的学生发送；未绑定时以应用内弹窗提醒为准。</view>
  </view>

  <!-- ===== 多角色：切换身份 ===== -->
  <block wx:if="{{canSwitch}}">
    <view class="section-title">切换身份</view>
    <view class="card role-card">
      <view
        class="role-item {{item.current ? 'current' : ''}}"
        wx:for="{{roles}}"
        wx:key="code"
        data-code="{{item.code}}"
        bindtap="onSwitchRole"
        hover-class="role-hover"
      >
        <view class="role-label">{{item.label}}</view>
        <view class="role-state">{{item.current ? '当前身份' : '点击切换'}}</view>
      </view>
      <view class="role-note">切换身份仅改变可用的功能范围，数据范围不变。</view>
    </view>
  </block>

  <!-- ===== 设置 ===== -->
  <view class="section-title">账号设置</view>
  <view class="card menu-card">
    <view class="cell" bindtap="openPwd" hover-class="cell-hover">
      <text class="menu-icon">🔒</text>
      <text>修改密码</text>
      <text class="cell-arrow">›</text>
    </view>
    <view class="cell" bindtap="onAbout" hover-class="cell-hover">
      <text class="menu-icon">ℹ️</text>
      <text>关于</text>
      <text class="cell-arrow">›</text>
    </view>
  </view>

  <view class="card logout-card" bindtap="onLogout" hover-class="logout-hover">
    <text class="logout">退出登录</text>
  </view>

  <view class="version">教材征订小程序 v{{version}}</view>
  <view class="version env">{{envText}}</view>

  <!-- ===== 改密弹层 ===== -->
  <view class="mask" wx:if="{{pwdShow}}" catchtap="closePwd">
    <view class="modal" catchtap="noop">
      <view class="modal-title">修改密码</view>
      <view class="input-row">
        <view class="input-label">原密码</view>
        <input password placeholder="请输入原密码" placeholder-class="ph" value="{{oldPassword}}" bindinput="onOldPwdInput" />
      </view>
      <view class="input-row">
        <view class="input-label">新密码</view>
        <input password placeholder="8 位以上，含字母和数字" placeholder-class="ph" value="{{newPassword}}" bindinput="onNewPwdInput" />
      </view>
      <view class="input-row">
        <view class="input-label">确认新密码</view>
        <input password placeholder="请再次输入新密码" placeholder-class="ph" value="{{newPassword2}}" bindinput="onNewPwd2Input" />
      </view>
      <view class="error-tip" wx:if="{{pwdError}}">{{pwdError}}</view>
      <view class="modal-actions">
        <view class="modal-btn ghost" hover-class="modal-btn-hover" catchtap="closePwd">取消</view>
        <view class="modal-btn primary" hover-class="modal-btn-hover" catchtap="onSubmitPwd">
          {{pwdSaving ? '提交中…' : '确认修改'}}
        </view>
      </view>
    </view>
  </view>
</view>
