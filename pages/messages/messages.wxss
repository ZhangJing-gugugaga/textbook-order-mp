.page { padding-bottom: 40rpx; }

.notice { display: flex; align-items: flex-start; margin-top: 24rpx; }
.notice-icon { font-size: 48rpx; margin-right: 20rpx; }
.notice-text { flex: 1; }
.notice-text .text-weak { margin-top: 8rpx; line-height: 1.7; }

.msg-card { margin-top: 16rpx; }
.msg-head { display: flex; align-items: center; }
.msg-icon { font-size: 40rpx; margin-right: 16rpx; }
.msg-title { flex: 1; font-size: 30rpx; font-weight: 500; }
.msg-time { flex-shrink: 0; }
.msg-content { margin-top: 12rpx; line-height: 1.7; }
