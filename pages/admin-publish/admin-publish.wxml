<view class="page">
  <view class="card">
    <view class="h2 form-title">任务信息</view>
    <view class="field">
      <view class="field-label">任务名称</view>
      <input placeholder="如：2026-2027学年第一学期教材征订" value="{{title}}" bindinput="onTitleInput" />
    </view>
    <view class="field">
      <view class="field-label">截止日期</view>
      <picker mode="date" value="{{deadline}}" start="{{today}}" bindchange="onDeadlineChange">
        <view class="picker-value {{deadline ? '' : 'placeholder'}}">{{deadline || '请选择截止日期'}}</view>
      </picker>
    </view>
  </view>

  <view class="section-title">征订范围（勾选班级）</view>
  <view class="card scope-card">
    <view wx:for="{{classGroups}}" wx:key="collegeId" wx:for-item="g">
      <view class="group-name">{{g.collegeName}}</view>
      <view class="class-row">
        <view
          wx:for="{{g.classes}}"
          wx:key="id"
          wx:for-item="c"
          class="chip {{c.picked ? 'chip-on' : ''}}"
          bindtap="toggleClass"
          data-id="{{c.id}}"
        >{{c.majorName}}{{c.name}}</view>
      </view>
    </view>
    <view class="text-weak scope-sum">已选 {{pickedClassCount}} 个班级</view>
  </view>

  <view class="section-title">关联教材（勾选书目）</view>
  <view class="card book-scope">
    <view class="pick-row" wx:for="{{bookOptions}}" wx:key="id" wx:for-item="b" bindtap="toggleBook" data-id="{{b.id}}">
      <view class="check-box {{b.picked ? 'checked' : ''}}">{{b.picked ? '✓' : ''}}</view>
      <view class="pick-main">
        <view class="pick-title">{{b.title}}</view>
        <view class="text-weak">{{b.course}} · ¥{{b.price}} · 适用 {{b.classCount}} 个班</view>
      </view>
    </view>
    <view class="empty" wx:if="{{bookOptions.length === 0}}">
      <view>教材库为空，请先到「教材管理」导入书目</view>
    </view>
    <view class="text-weak scope-sum">已选 {{pickedBookCount}} 种教材</view>
  </view>

  <view class="submit-wrap">
    <button class="btn-primary" bindtap="onPublish">发布征订任务</button>
  </view>
</view>
