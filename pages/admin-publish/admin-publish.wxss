.page { padding-bottom: 180rpx; }
.form-title { margin-bottom: 8rpx; }
.field {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F1F5F9;
}
.field:last-child { border-bottom: none; }
.field-label { width: 180rpx; color: #475569; font-size: 28rpx; }
.field input { flex: 1; font-size: 28rpx; }
.picker-value { font-size: 28rpx; color: #1E1B4B; }
.picker-value.placeholder { color: #94A3B8; }

/* 班级选择 */
.scope-card { margin-top: 8rpx; }
.group-name { font-size: 26rpx; font-weight: 600; color: #1E1B4B; margin: 16rpx 0 12rpx; }
.class-row { display: flex; flex-wrap: wrap; gap: 16rpx; }
.chip {
  padding: 10rpx 24rpx;
  background: #EEF2FF;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #475569;
  border: 2rpx solid transparent;
}
.chip-on {
  background: #EEF2FF;
  color: #4F46E5;
  border-color: #4F46E5;
  font-weight: 500;
}
.scope-sum { margin-top: 20rpx; text-align: right; }

/* 教材选择 */
.book-scope { margin-top: 8rpx; }
.pick-row { display: flex; align-items: center; padding: 18rpx 0; }
.check-box {
  width: 38rpx;
  height: 38rpx;
  border-radius: 10rpx;
  border: 3rpx solid #C7D2FE;
  color: #FFF;
  font-size: 24rpx;
  line-height: 36rpx;
  text-align: center;
  box-sizing: border-box;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.check-box.checked { background: #4F46E5; border-color: #4F46E5; }
.pick-main { flex: 1; }
.pick-title { font-size: 28rpx; font-weight: 500; }

.submit-wrap {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  background: #FFF;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 20rpx rgba(26,34,51,0.06);
}
