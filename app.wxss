/* 教材征订小程序 - 全局设计系统 v2（靛蓝校园风 · ui-ux-pro-max 规范） */
page {
  background: #EEF2FF;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
  font-size: 28rpx;
  color: #1E1B4B;
  box-sizing: border-box;
  -webkit-font-smoothing: antialiased;
}

/* ===== 色彩令牌 =====
   primary #4F46E5 / gradient #4F46E5→#6366F1
   accent  #EA580C（价格、紧急、CTA点缀）
   bg #EEF2FF / card #FFFFFF / fg #1E1B4B / muted-fg #475569
   success #16A34A / warning #EA580C / danger #DC2626
   border #C7D2FE（浅靛蓝描边） */

/* ===== 卡片体系：双层柔影 ===== */
.card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  margin: 20rpx 24rpx;
  box-shadow: 0 1rpx 2rpx rgba(79, 70, 229, 0.04), 0 8rpx 24rpx rgba(30, 27, 75, 0.06);
}

/* 强调卡：用于概览/头部等高权重区块 */
.card-hero {
  background: linear-gradient(135deg, #4F46E5 0%, #6366F1 60%, #818CF8 100%);
  border-radius: 28rpx;
  padding: 36rpx 32rpx;
  margin: 20rpx 24rpx;
  color: #FFFFFF;
  box-shadow: 0 12rpx 32rpx rgba(79, 70, 229, 0.35);
  position: relative;
  overflow: hidden;
}
/* hero 卡右上装饰圆 */
.card-hero::after {
  content: '';
  position: absolute;
  right: -60rpx;
  top: -60rpx;
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.12);
}

/* ===== 文字层级 ===== */
.h1 { font-size: 40rpx; font-weight: 700; color: #1E1B4B; letter-spacing: 0.5rpx; }
.h2 { font-size: 32rpx; font-weight: 600; color: #1E1B4B; }
.text-sub { font-size: 26rpx; color: #475569; }
.text-weak { font-size: 24rpx; color: #94A3B8; }

/* ===== 按钮体系 ===== */
.btn-primary {
  background: linear-gradient(135deg, #4F46E5, #6366F1);
  color: #FFFFFF;
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  padding: 26rpx 0;
  border: none;
  line-height: 1.4;
  letter-spacing: 2rpx;
  box-shadow: 0 8rpx 20rpx rgba(79, 70, 229, 0.3);
  transition: transform 150ms ease, box-shadow 150ms ease;
}
.btn-primary::after { border: none; }
.btn-primary.button-hover {
  transform: translateY(2rpx) scale(0.98);
  box-shadow: 0 4rpx 10rpx rgba(79, 70, 229, 0.3);
}
.btn-primary[disabled] {
  background: #C7D2FE;
  color: #FFFFFF;
  box-shadow: none;
}
.btn-ghost {
  background: #FFFFFF;
  color: #4F46E5;
  border: 2rpx solid #C7D2FE;
  border-radius: 48rpx;
  font-size: 28rpx;
  font-weight: 500;
  text-align: center;
  padding: 22rpx 0;
  line-height: 1.4;
  transition: background 150ms ease;
}
.btn-ghost::after { border: none; }
.btn-ghost.button-hover { background: #EEF2FF; }

/* ===== 图标徽章：容器化 emoji，替代裸表情 ===== */
.icon-badge {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  font-size: 44rpx;
  box-shadow: 0 4rpx 12rpx rgba(30, 27, 75, 0.08);
}
.icon-indigo { background: linear-gradient(135deg, #EEF2FF, #E0E7FF); }
.icon-green  { background: linear-gradient(135deg, #ECFDF5, #D1FAE5); }
.icon-orange { background: linear-gradient(135deg, #FFF7ED, #FFEDD5); }
.icon-pink   { background: linear-gradient(135deg, #FDF2F8, #FCE7F3); }
.icon-blue   { background: linear-gradient(135deg, #EFF6FF, #DBEAFE); }

/* ===== 标签 ===== */
.tag {
  display: inline-block;
  font-size: 22rpx;
  font-weight: 500;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  line-height: 1.6;
}
.tag-required { background: #FEF2F2; color: #DC2626; }
.tag-optional { background: #EEF2FF; color: #4F46E5; }
.tag-success { background: #ECFDF5; color: #16A34A; }
.tag-warning { background: #FFF7ED; color: #EA580C; }
.tag-blue { background: #EEF2FF; color: #4F46E5; }

/* ===== 输入框 ===== */
.input-row {
  display: flex;
  align-items: center;
  background: #F8FAFF;
  border: 2rpx solid #E0E7FF;
  border-radius: 20rpx;
  padding: 26rpx 30rpx;
  margin-bottom: 22rpx;
  transition: border-color 150ms ease;
}
.input-row:focus-within {
  border-color: #4F46E5;
  background: #FFFFFF;
}
.input-row input {
  flex: 1;
  font-size: 30rpx;
  color: #1E1B4B;
}
.input-label {
  width: 170rpx;
  font-size: 28rpx;
  color: #475569;
  font-weight: 500;
}

/* ===== 列表单元 ===== */
.cell {
  display: flex;
  align-items: center;
  padding: 30rpx 32rpx;
  background: #FFFFFF;
  border-bottom: 1rpx solid #F1F5F9;
  transition: background 150ms ease;
}
.cell:active { background: #F8FAFF; }
.cell:last-child { border-bottom: none; }
.cell-arrow {
  color: #C7D2FE;
  font-size: 32rpx;
  margin-left: auto;
}

/* ===== 分组标题 ===== */
.section-title {
  display: flex;
  align-items: center;
  font-size: 30rpx;
  font-weight: 700;
  color: #1E1B4B;
  margin: 36rpx 32rpx 12rpx;
  letter-spacing: 0.5rpx;
}
.section-title::before {
  content: '';
  width: 8rpx;
  height: 30rpx;
  border-radius: 4rpx;
  background: linear-gradient(180deg, #4F46E5, #818CF8);
  margin-right: 14rpx;
}

/* ===== 空状态 ===== */
.empty {
  text-align: center;
  padding: 100rpx 0;
  color: #94A3B8;
  font-size: 26rpx;
}
.empty-icon { font-size: 80rpx; margin-bottom: 20rpx; }

/* ===== 进度条 ===== */
.progress-track {
  height: 16rpx;
  background: #E0E7FF;
  border-radius: 999rpx;
  overflow: hidden;
}
.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #4F46E5, #818CF8);
  border-radius: 999rpx;
}

/* ===== 数字强调 ===== */
.num-hero {
  font-size: 52rpx;
  font-weight: 800;
  line-height: 1.2;
  font-family: 'DIN Alternate', -apple-system, sans-serif;
}
